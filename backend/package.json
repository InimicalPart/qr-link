{
  "name": "qrlink-api",
  "version": "1.0.0",
  "description": "A QR-code that can change where it points to",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run clean && tsc && npm run copyenv",
    "copyenv": "cp .env dist/.env",
    "build_and_run": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "watch": "nodemon -x \"npm run build_and_run\" -e ts,env"
  },
  "author": "Inimi",
  "license": "MIT",
  "dependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@workos-inc/node": "^5.1.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jose": "^5.2.0",
    "jsonc-parser": "^3.2.1",
    "moment-timezone": "^0.5.44",
    "mongodb": "^6.3.0",
    "puppeteer": "^20.3.0",
    "qrcode": "^1.5.3",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.5",
    "tailwindcss": "^3.4.1"
  }
}
